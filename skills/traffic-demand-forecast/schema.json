{
  "skill_id": "de_local_05_sk03",
  "name": "客流需求预测",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": [
      "history"
    ],
    "properties": {
      "history": {
        "type": "string",
        "description": "历史数据：带时间的序列数据"
      },
      "horizon": {
        "type": "string",
        "description": "预测区间：要预测未来多长时间（可选）"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "forecast",
      "basis",
      "uncertainty"
    ],
    "properties": {
      "forecast": {
        "type": "array",
        "description": "逐期给出预测值与区间",
        "items": {
          "type": "object",
          "properties": {
            "周期": {
              "type": "string"
            },
            "预测值": {
              "type": "string"
            },
            "下限": {
              "type": "string"
            },
            "上限": {
              "type": "string"
            }
          }
        }
      },
      "basis": {
        "type": "string",
        "description": "所用方法与关键假设"
      },
      "uncertainty": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "影响预测准确度的因素"
      }
    },
    "x-rendered-from": "capability:forecast"
  },
  "constraints": {
    "max_input_length": 5000,
    "forbidden_words": [
      "最好",
      "第一",
      "100%"
    ],
    "ai_label_required": true,
    "human_review_required": true,
    "external_api_required": false
  }
}