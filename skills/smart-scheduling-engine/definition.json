{
  "id": "skill-smart-scheduling-engine",
  "name": "多资源排班",
  "version": "0.3.0-rc.1",
  "kind": "generic",
  "purpose": "作为受理、日排班和冲突流程的共享多资源排班技能，保留设备资源与未排原因，不仅生成日历。",
  "conditions": [
    "绑定d6完整原文；按客户体验、负荷均衡、场地利用率的员工级优先序处理，不静默覆盖。",
    "设备占用字段与约束算法未具体给出，需父任务补齐；改派需复检及人工确认。"
  ],
  "acceptance": [
    "输入items及资源约束，输出schedule、conflicts、unscheduled和利用率；验证指名→期望时段→提交顺序、班次休息培训、15分钟缓冲、末单及房型，保留超负荷与可补单提示。"
  ],
