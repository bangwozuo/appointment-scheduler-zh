{
  "id": "skill-call-no-show-backfill",
  "name": "爽约风险与候补",
  "version": "0.3.0-rc.1",
  "kind": "workflow_call",
  "purpose": "保留每日两次风险评分、提前确认及候补轮转工作流，工具计算风险，通知技能生成触达排期。",
  "conditions": [
    "绑定d9完整原文；原评分公式不能作为已校准概率，定金等缺省处理、候补排序与状态回执需补齐。",
    "自动通知描述不授予发送权限；仍需老板确认、前台执行，高风险标签不向客户披露。"
  ],
  "acceptance": [
    "保留全部原评分因子、上限与分层阈值，高风险前2小时、中风险前30分钟、静默及每日2条约束；一空位一次仅通知一位候补，30分钟未确认再顺延；风险表、图和JSON待授权实测。"
  ],
  "knowledge_ids": [
