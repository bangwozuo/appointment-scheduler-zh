    {
      "key": "forecast_method",
      "title": "星期均值预测与经验区间解释",
      "kind": "method",
      "supply": "source_supported",
      "consumers": [
        "d7"
      ],
      "content_requirements": [
        "从d7保留星期均值、趋势系数缺省+3%、7天输出、少于7天拒绝、±15%经验区间及节假日标注，不将经验带称统计置信区间；示例数值需独立复算。"
      ],
      "evidence": {
        "source_key": "d7",
        "quote": "区间±15%是经验取值而非统计置信区间"
      },
      "id": "appointment-scheduler-zh:knowledge:forecast_method",
