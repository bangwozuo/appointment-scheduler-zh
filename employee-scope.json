  "source_conflicts": [
    {
      "issue": "员工卡及包声明纯提示词无依赖，但d5、d7及五流程要求确定性脚本产物。",
      "resolution": "按完整业务义务保留工具与技能组合；退回父任务补脚本、依赖、schema及执行证据，不能据无Key声明推定可生产运行。",
      "evidence": {
        "source_key": "d5",
        "quote": "数值计算由脚本"
      }
    },
    {
      "issue": "d9步骤说明称候补自动通知，与d4及d9人工发送边界不一致；客流预测技能也未定义个人爽约打分接口。",
      "resolution": "保留候补通知业务动作但不声称已发送；以老板确认前台执行为闸门，另补风险工具与客流预测的数据契约，不假定名称相近即支持。",
      "evidence": {
        "source_key": "d9",
        "quote": "历史爽约特征打分 → 高风险预约提前确认 → 爽约后候补名单自动通知"
      }
    },
    {
      "issue": "d6示例冲突解释称12:15前无完整60分钟空档，却排出11:15-12:15；17:00预约不满足末单时长的解释也未由19:00开始红线推出。",
      "resolution": "原例作为附件保留但不当金标准；要求主审按班次、缓冲和开始结束边界复核，不据错误说明删减能力。",
      "evidence": {
        "source_key": "d6",
        "quote": "王丽在12:15前无完整60分钟空档"
      }
    },
    {
      "issue": "secondary合同与主合同能力多数重复，另明确不做绩效仲裁；其Skill正文均未提供。",
      "resolution": "补充不接管收银、不做技师绩效仲裁边界；其余同名能力只作重复合同来源，不认定已读secondary技能或新增资产。",
      "evidence": {
        "source_key": "d13",
        "quote": "不接管收银、不做技师绩效仲裁"
      }
    },
    {
      "issue": "KPI、ROI与示例实跑描述不构成本次真实效果或当前执行证明。",
      "resolution": "作为目标保留，需客户基线、观测周期和可追溯实绩后另行评估，不宣称漏单归零或爽约下降已实现。",
      "evidence": {
        "source_key": "d2",
        "quote": "漏单错单率 → 0；爽约率下降 ≥30%；低谷时段上座率提升可追踪"
      }
    }
  ],
  "external_requirements": [
    {
      "operation": "确定性计算与文件产出",
      "requirement": "父任务补齐d5/d7脚本、各流程run_flow脚本、prompt与schema原文及版本依赖；由授权环境执行并提供输入摘要、日志和产物核验。本专家无工具且未运行，不把文件清单计为已交付。",
      "evidence": {
        "source_key": "d12",
        "quote": "排位与利用率不用模型口算——以脚本输出为准"
      }
    },
    {
      "operation": "预约读取、事件与定时触发",
      "requirement": "补官方API或用户导出授权、门店隔离、事件时间与快照版本；实现6:30、每日两次、周一调度及写入后30秒扫描的可追踪凭据。收银接口仅可选只读核销，不接管收银。",
      "evidence": {
        "source_key": "d2",
        "quote": "连接器仅**文档说明**，资产包不含任何连接器代码。"
      }
    },
    {
      "operation": "写单、下发、改派、通知与促销发布",
      "requirement": "这些真实副作用仍属原流程后续必需动作，交父任务安排有权限人员执行并留确认和回执；本次仅分析，不写入、不审批、不委派。分别保留客户前台受理确认、店长排班确认、老板客户改派双确认及老板触达促销确认。",
      "evidence": {
        "source_key": "d10",
        "quote": "不在客户未确认前写单或通知技师"
      }
    },
    {
      "operation": "知识事实取得及语义主审",
      "requirement": "原125条占位不作事实；取得本客户配置与记录后核对完整原文附件及合同覆盖，解决设备约束、风险算法、去重与边界歧义。机械非空和覆盖检查不能替代业务主审，也不能据平台导入表推定兼容。",
      "evidence": {
        "source_key": "d8",
        "quote": "步骤间输入输出字段可衔接"
      }
    }
  ],
