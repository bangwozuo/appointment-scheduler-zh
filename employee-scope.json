      "kind": "template",
      "supply": "customer_configuration",
      "consumers": [
        "d5"
      ],
      "content_requirements": [
        "由店长或财务提供生效版制度、品类费率、渠道扣点、计提基数、舍入及退卡规则，和指定期间技师排班核销、收入、渠道、售卡记录。",
        "通过客户授权导出或可选收银SaaS只读核销接口取得，禁止把15%、5%、3%示例当默认客户制度。"
      ],
      "evidence": {
        "source_key": "d5",
